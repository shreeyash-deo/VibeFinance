# VibeFinance Configuration
DATABASE_URL=sqlite+aiosqlite:///./vibefinance.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/vibefinance

# LLM Provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default App Settings
DEFAULT_DATA_MODE=cached
DEFAULT_USER_ID=meena

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

